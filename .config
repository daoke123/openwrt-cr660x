CONFIG_TARGET_ramips=y
CONFIG_TARGET_SUBTARGET_mt7621=y
CONFIG_TARGET_PROFILE_XIAOMI_MI_ROUTER_CR660X=y
CONFIG_INTERFACE_LAN='192.168.66.1'

# LuCI / theme
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y

# Wireless / MT7621
CONFIG_PACKAGE_kmod-mt76-xqca=y
CONFIG_PACKAGE_kmod-mt7621=y
CONFIG_PACKAGE_kmod-mt7663-firmware-ap=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# MosDNS (third-party: sbwml/luci-app-mosdns)
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_geo2txt=y
CONFIG_PACKAGE_ucode=y
